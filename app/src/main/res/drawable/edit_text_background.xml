<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- creates drawable shape -->

    <solid android:color="#E6E6FA"/>
    <!--fill in with lavender-->
    <corners android:radius="8dp"/>
    <!--rounder corners -->

    <stroke
        android:width="1dp"
        android:color="#B39DDB"/>
    <!-- soft border of light purple -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>
    <!-- inner padding -->

</shape>